<%- include('partials/header', {title: 'Послуги'}) %>
<h1 class="my-4">Види консультацій</h1>
<div class="table-responsive">
<table class="table table-striped">
  <thead>
    <tr>
      <th>ID</th><th>Назва</th><th>Формат</th>
      <th>Тривалість (хв)</th><th>Ціна (грн)</th><th>Опис</th>
    </tr>
  </thead>
  <tbody>
    <% services.forEach(function(s) { %>
      <tr>
        <td><%= s.service_id %></td>
        <td><%= s.service_name %></td>
        <td><%= s.format %></td>
        <td><%= s.duration_min %></td>
        <td><%= s.price %></td>
        <td><%= s.description || "—" %></td>
      </tr>
    <% }); %>
  </tbody>
</table>
</div>
<%- include('partials/footer') %>