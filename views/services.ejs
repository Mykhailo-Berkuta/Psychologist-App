<%- include('partials/header', {title: 'Послуги'}) %>
<h1 class="my-4">Види консультацій</h1>
<div class="table-responsive">
<table class="table table-striped">
  <thead>
    <tr>
      <th>ID</th><th>Назва</th><th>Формат</th>
      <th>Тривалість (хв)</th><th>Ціна (грн)</th><th>Опис</th><th>Дії</th>
    </tr>
  </thead>
  <tbody>
    <% services.forEach(function(s) { %>
      <tr>
        <td><%= s.service_id %></td>
        <td><%= s.service_name %></td>
        <td><%= s.format %></td>
        <td><%= s.duration_min %></td>
        <td><%= s.price %></td>
        <td><%= s.description || "—" %></td>
        <td class="text-nowrap">
          <a href="/edit_service/<%= s.service_id %>" class="btn btn-warning btn-sm">Оновити</a>
          <button class="btn btn-danger btn-sm" data-id="<%= s.service_id %>" onclick="deleteService(this.dataset.id)">Видалити</button>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>
</div>
<a href="/add_service" class="btn btn-success mb-4">Додати послугу</a>

<script>
function deleteService(id) {
  if (confirm("Видалити послугу? У консультаціях з цією послугою поле «Послуга» стане порожнім.")) {
    sendRequest("/services/" + id, "DELETE");
  }
}
</script>
<%- include('partials/footer') %>