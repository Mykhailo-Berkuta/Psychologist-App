<%- include('partials/header', {title: 'Додати послугу'}) %>
<h1 class="my-4">Додати вид консультації</h1>
<form action="/add_service" method="post">
  <div class="mb-3">
    <label class="form-label">Назва</label>
    <input type="text" class="form-control" name="service_name" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Формат</label>
    <select class="form-select" name="format" required>
      <option>Онлайн</option>
      <option>Офлайн</option>
    </select>
  </div>
  <div class="mb-3">
    <label class="form-label">Тривалість (хв)</label>
    <input type="number" class="form-control" name="duration_min" min="1" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Ціна (грн)</label>
    <input type="number" step="0.01" class="form-control" name="price" min="0" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Опис</label>
    <input type="text" class="form-control" name="description">
  </div>
  <button type="submit" class="btn btn-success mb-4">Зберегти</button>
  <a href="/services" class="btn btn-secondary mb-4">Скасувати</a>
</form>
<%- include('partials/footer') %>