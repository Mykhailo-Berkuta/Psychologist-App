<%- include('partials/header', {title: 'Редагувати послугу'}) %>
<h1 class="my-4">Редагувати вид консультації</h1>
<form id="editForm">
  <div class="mb-3">
    <label class="form-label">Назва</label>
    <input type="text" class="form-control" name="service_name" value="<%= service.service_name %>" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Формат</label>
    <select class="form-select" name="format" required>
      <% ["Онлайн", "Офлайн"].forEach(function(f) { %>
        <option <%= service.format === f ? "selected" : "" %>><%= f %></option>
      <% }); %>
    </select>
  </div>
  <div class="mb-3">
    <label class="form-label">Тривалість (хв)</label>
    <input type="number" class="form-control" name="duration_min" min="1" value="<%= service.duration_min %>" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Ціна (грн)</label>
    <input type="number" step="0.01" class="form-control" name="price" min="0" value="<%= service.price %>" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Опис</label>
    <input type="text" class="form-control" name="description" value="<%= service.description || '' %>">
  </div>
  <button type="submit" class="btn btn-success mb-4">Зберегти зміни</button>
  <a href="/services" class="btn btn-secondary mb-4">Скасувати</a>
</form>

<script>
document.getElementById("editForm").addEventListener("submit", function (e) {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(e.target));
  sendRequest("/services/<%= service.service_id %>", "PUT", data);
});
</script>
<%- include('partials/footer') %>