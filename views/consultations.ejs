<%- include('partials/header', {title: 'Консультації'}) %>
<h1 class="my-4">Консультації</h1>
<div class="table-responsive">
<table class="table table-striped">
  <thead>
    <tr>
      <th>ID</th><th>Клієнт</th><th>Послуга</th><th>Дата і час</th>
      <th>Статус</th><th>Оплата</th><th>Нотатки</th><th>Дії</th>
    </tr>
  </thead>
  <tbody>
    <% consultations.forEach(function(c) { %>
      <tr>
        <td><%= c.consultation_id %></td>
        <td><%= c.full_name %></td>
        <td><%= c.service_name ? c.service_name + " (" + c.format + ")" : "—" %></td>
        <td><%= new Date(c.consultation_date).toLocaleString("uk-UA", {dateStyle: "short", timeStyle: "short"}) %></td>
        <td><%= c.status %></td>
        <td><%= c.payment_status || "—" %></td>
        <td><%= c.notes || "—" %></td>
        <td class="text-nowrap">
          <a href="/edit_consultation/<%= c.consultation_id %>" class="btn btn-warning btn-sm">Оновити</a>
          <button class="btn btn-danger btn-sm" data-id="<%= c.consultation_id %>" onclick="deleteConsultation(this.dataset.id)">Видалити</button>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>
</div>
<a href="/add_consultation" class="btn btn-success mb-4">Додати консультацію</a>

<script>
function deleteConsultation(id) {
  if (confirm("Видалити консультацію?")) {
    sendRequest("/consultations/" + id, "DELETE");
  }
}
</script>
<%- include('partials/footer') %>